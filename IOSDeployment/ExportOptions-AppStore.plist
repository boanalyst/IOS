<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- method: app-store uploads to App Store Connect / TestFlight -->
    <key>method</key>
    <string>app-store</string>

    <!-- teamID is injected at build-time by codemagic.yaml from $APPLE_TEAM_ID env var -->
    <!-- This file is a fallback template only. The build script overwrites it. -->
    <key>teamID</key>
    <string>REPLACE_WITH_TEAM_ID</string>

    <!-- uploadBitcode: Apple stopped requiring bitcode in Xcode 14+ -->
    <key>uploadBitcode</key>
    <false/>

    <!-- uploadSymbols: required for crash symbolication in App Store Connect -->
    <key>uploadSymbols</key>
    <true/>

    <!-- signingStyle: manual — Codemagic fetches and applies profiles automatically -->
    <key>signingStyle</key>
    <string>manual</string>
</dict>
</plist>

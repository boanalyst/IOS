<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- ── App Identity ─────────────────────────────────────────────────── -->
  <key>CFBundleName</key>
  <string>BoAnalyst</string>
  <key>CFBundleDisplayName</key>
  <string>BoAnalyst</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleShortVersionString</key>
  <string>1.1.6</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleIconName</key>
  <string>AppIcon</string>

  <!-- ── Supported OS / Orientations ──────────────────────────────────── -->
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <key>UIRequiresFullScreen</key>
  <true/>

  <!-- ── App Transport Security ────────────────────────────────────────── -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
    <key>NSExceptionDomains</key>
    <dict>
      <!-- BoAnalyst backend + CDN -->
      <key>boanalyst.com</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <!-- TMDB movie poster images -->
      <key>themoviedb.org</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <key>image.tmdb.org</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <key>media.themoviedb.org</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <!-- Twitter / X embed widget -->
      <key>twitter.com</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <key>x.com</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <key>twimg.com</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <!-- Instagram embed -->
      <key>instagram.com</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <key>cdninstagram.com</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <!-- YouTube thumbnails + mobile player -->
      <key>youtube.com</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <key>ytimg.com</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
      <key>googlevideo.com</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><false/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
    </dict>
  </dict>

  <!-- ── URL Scheme (OAuth deep-link: boanalyst://auth?token=...) ──────── -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.boanalyst.app</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>boanalyst</string>
      </array>
    </dict>
  </array>

  <!-- ── Privacy Usage Descriptions (Apple required) ──────────────────── -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>BoAnalyst needs access to your photo library to attach images to posts.</string>

  <key>NSCameraUsageDescription</key>
  <string>BoAnalyst needs camera access to take photos for your posts.</string>

  <key>NSFaceIDUsageDescription</key>
  <string>BoAnalyst uses Face ID to securely authenticate your account.</string>

  <key>NSUserNotificationsUsageDescription</key>
  <string>BoAnalyst sends notifications about new posts, box office updates, and replies.</string>


  <!-- ── Custom Fonts ───────────────────────────────────────────────────── -->
  <key>UIAppFonts</key>
  <array>
    <string>Cinzel-Regular.ttf</string>
    <string>Cinzel-Bold.ttf</string>
    <string>Cinzel-Black.ttf</string>
  </array>

  <!-- ── Scene Manifest (SwiftUI lifecycle) ───────────────────────────── -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
  </dict>

  <!-- ── Apple Export Compliance ──────────────────────────────────────── -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <!-- ── Google AdMob Setup (Production iOS ID) ── -->
  <key>GADApplicationIdentifier</key>
  <string>ca-app-pub-5734863079459748~9986914659</string>

  <!-- Apple SKAdNetwork Identifiers (AdMob Performance Tracking) -->
  <key>SKAdNetworkItems</key>
  <array>
    <dict>
      <key>SKAdNetworkIdentifier</key>
      <string>cstr6suwn9.skadnetwork</string>
    </dict>
    <dict>
      <key>SKAdNetworkIdentifier</key>
      <string>4fqxafvjvp.skadnetwork</string>
    </dict>
    <dict>
      <key>SKAdNetworkIdentifier</key>
      <string>5l3tpt7t6e.skadnetwork</string>
    </dict>
    <dict>
      <key>SKAdNetworkIdentifier</key>
      <string>wzmmz9fp6w.skadnetwork</string>
    </dict>
  </array>

</dict>
</plist>
